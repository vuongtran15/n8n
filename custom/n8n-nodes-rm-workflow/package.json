{
  "name": "n8n-nodes-rm-workflow",
  "version": "0.1.0",
  "description": "Kito custom nodes — RM Workflow group",
  "license": "MIT",
  "keywords": ["n8n-community-node-package", "rm-workflow"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/generate-translations.mjs && node scripts/copy-codex.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "generate:translations": "node scripts/generate-translations.mjs"
  },
  "files": ["dist"],
  "dependencies": {
    "axios": "catalog:"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/RMWorkflow/RMWidget.node.js",
      "dist/nodes/RMWorkflow/RmInit.node.js",
      "dist/nodes/RMWorkflow/RmUuid.node.js",
      "dist/nodes/RMWorkflow/RmHasData.node.js",
      "dist/nodes/RMWorkflow/RmCopyContext.node.js",
      "dist/nodes/RmSapWorkflow/RmSapWorkflow.node.js",
      "dist/nodes/RmWebAutoWorkflow/RmWebAutoWorkflow.node.js",
      "dist/nodes/RmFileAutoWorkflow/RmFileAutoWorkflow.node.js",
      "dist/nodes/RmOutlookAutoWorkflow/RmOutlookAutoWorkflow.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "n8n-workflow": "workspace:*",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  }
}
