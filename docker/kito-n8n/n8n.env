# Copy to packages/cli/bin/.env before pnpm dev:be
#   copy docker\kito-n8n\n8n.env packages\cli\bin\.env

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n_db
DB_POSTGRESDB_USER=ktuser
DB_POSTGRESDB_PASSWORD=kt123qwe***
EXECUTIONS_MODE=queue
QUEUE_BULL_REDIS_HOST=localhost
QUEUE_BULL_REDIS_PORT=6379
N8N_CACHE_ENABLED=true
N8N_CACHE_BACKEND=redis
N8N_CACHE_REDIS_HOST=localhost
N8N_CACHE_REDIS_PORT=6379

# Hide community / verified packages
N8N_COMMUNITY_PACKAGES_ENABLED=false
N8N_VERIFIED_PACKAGES_ENABLED=false
N8N_UNVERIFIED_PACKAGES_ENABLED=false

# Hide Python on Code node (also removed from node description in Code.node.ts)
N8N_PYTHON_ENABLED=false

# Custom RM Workflow package (outside nodes-base — safe for fork/merge).
# Change path if your repo is not at E:/CODE/N8N/n8n
N8N_CUSTOM_EXTENSIONS=E:/CODE/N8N/n8n/custom/n8n-nodes-rm-workflow

# Core workflow nodes + AI Agent stack (@n8n/n8n-nodes-langchain — NOT nodes-base)
# Empty NODES_INCLUDE = load ALL built-in apps
# Custom nodes loaded via N8N_CUSTOM_EXTENSIONS use package prefix CUSTOM.*
NODES_INCLUDE=["n8n-nodes-base.manualTrigger","n8n-nodes-base.scheduleTrigger","n8n-nodes-base.webhook","n8n-nodes-base.respondToWebhook","n8n-nodes-base.errorTrigger","n8n-nodes-base.executeWorkflow","n8n-nodes-base.executeWorkflowTrigger","CUSTOM.rmCallSubworkflow","n8n-nodes-base.code","n8n-nodes-base.if","n8n-nodes-base.switch","n8n-nodes-base.splitInBatches","n8n-nodes-base.filter","n8n-nodes-base.set","n8n-nodes-base.merge","n8n-nodes-base.wait","n8n-nodes-base.noOp","n8n-nodes-base.stopAndError","n8n-nodes-base.stickyNote","n8n-nodes-base.httpRequest","n8n-nodes-base.readWriteFile","n8n-nodes-base.convertToFile","n8n-nodes-base.extractFromFile","n8n-nodes-base.spreadsheetFile","n8n-nodes-base.readPDF","n8n-nodes-base.compression","n8n-nodes-base.moveBinaryData","n8n-nodes-base.itemLists","n8n-nodes-base.aggregate","n8n-nodes-base.limit","n8n-nodes-base.removeDuplicates","n8n-nodes-base.sort","n8n-nodes-base.summarize","n8n-nodes-base.compareDatasets","n8n-nodes-base.dateTime","n8n-nodes-base.crypto","n8n-nodes-base.html","n8n-nodes-base.htmlExtract","n8n-nodes-base.xml","@n8n/n8n-nodes-langchain.agent","@n8n/n8n-nodes-langchain.agentTool","@n8n/n8n-nodes-langchain.chatTrigger","@n8n/n8n-nodes-langchain.manualChatTrigger","@n8n/n8n-nodes-langchain.lmChatOpenAi","@n8n/n8n-nodes-langchain.lmChatAnthropic","@n8n/n8n-nodes-langchain.lmChatGoogleGemini","@n8n/n8n-nodes-langchain.lmChatOllama","@n8n/n8n-nodes-langchain.memoryBufferWindow","@n8n/n8n-nodes-langchain.toolHttpRequest","@n8n/n8n-nodes-langchain.toolCode","@n8n/n8n-nodes-langchain.toolWorkflow","@n8n/n8n-nodes-langchain.toolCalculator","@n8n/n8n-nodes-langchain.toolThink"]
