# Copy to packages/cli/bin/.env before pnpm dev:be
#   copy docker\kito-n8n\n8n.env packages\cli\bin\.env

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=172.19.18.46
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=rm_workflow
DB_POSTGRESDB_USER=rm_workflow
DB_POSTGRESDB_PASSWORD=123qwe***
EXECUTIONS_MODE=queue
QUEUE_BULL_REDIS_HOST=172.19.137.30
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_DB=1
N8N_CACHE_ENABLED=true
N8N_CACHE_BACKEND=redis
N8N_CACHE_REDIS_HOST=172.19.137.30
N8N_CACHE_REDIS_PORT=6379

# Hide workflow templates (sidebar + routes)
N8N_TEMPLATES_ENABLED=false

# Default timezone for Schedule Trigger / cron / DateTime (GMT+7)
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# Hide community / verified packages
N8N_COMMUNITY_PACKAGES_ENABLED=false
N8N_VERIFIED_PACKAGES_ENABLED=false
N8N_UNVERIFIED_PACKAGES_ENABLED=false

# Hide Python on Code node (also removed from node description in Code.node.ts)
N8N_PYTHON_ENABLED=false

# Allow any workflow to call any sub-workflow by ID (cross-account execute; list UI still permission-scoped)
N8N_WORKFLOW_CALLER_POLICY_DEFAULT_OPTION=any

# Public URL + listen port (webhook Test/Production URLs use this)
N8N_HOST=ros.reginamiracle.com
N8N_PORT=201
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://ros.reginamiracle.com:201/
N8N_WEBHOOK_URL=https://ros.reginamiracle.com:201/
N8N_SECURE_COOKIE=true

# RM Widget portal API (optional — can also set in Settings → RM Workflow)
# RM_WORKFLOW_PORTAL_API_BASE_URL=https://ros.reginamiracle.com:200

# Change path if your repo is not at D:/CODE/N8N/n8n
# start-n8n-pm2.bat / sync-n8n-env.cmd se TU GHI LAI thanh path tuyet doi tren may dang chay.
N8N_CUSTOM_EXTENSIONS=D:/CODE/N8N/n8n/custom/n8n-nodes-rm-workflow

# Core workflow nodes + AI Agent stack (@n8n/n8n-nodes-langchain — NOT nodes-base)
# Empty NODES_INCLUDE = load ALL built-in apps
# Custom nodes loaded via N8N_CUSTOM_EXTENSIONS use package prefix CUSTOM.*
NODES_INCLUDE=["n8n-nodes-base.manualTrigger","n8n-nodes-base.scheduleTrigger","n8n-nodes-base.webhook","n8n-nodes-base.respondToWebhook","n8n-nodes-base.errorTrigger","n8n-nodes-base.executeWorkflow","n8n-nodes-base.executeWorkflowTrigger","CUSTOM.rmWidget","CUSTOM.rmInit","CUSTOM.rmUuid","CUSTOM.rmHasData","CUSTOM.rmCopyContext","CUSTOM.rmSapWorkflow","CUSTOM.rmWebAutoWorkflow","CUSTOM.rmFileAutoWorkflow","CUSTOM.rmOutlookAutoWorkflow","CUSTOM.rmWecomWorkflow","n8n-nodes-base.code","n8n-nodes-base.if","n8n-nodes-base.switch","n8n-nodes-base.splitInBatches","n8n-nodes-base.filter","n8n-nodes-base.set","n8n-nodes-base.merge","n8n-nodes-base.wait","n8n-nodes-base.noOp","n8n-nodes-base.stopAndError","n8n-nodes-base.stickyNote","n8n-nodes-base.httpRequest","n8n-nodes-base.postgres","n8n-nodes-base.microsoftSql","n8n-nodes-base.dataTable","n8n-nodes-base.readWriteFile","n8n-nodes-base.convertToFile","n8n-nodes-base.extractFromFile","n8n-nodes-base.spreadsheetFile","n8n-nodes-base.readPDF","n8n-nodes-base.compression","n8n-nodes-base.moveBinaryData","n8n-nodes-base.itemLists","n8n-nodes-base.aggregate","n8n-nodes-base.limit","n8n-nodes-base.removeDuplicates","n8n-nodes-base.sort","n8n-nodes-base.summarize","n8n-nodes-base.compareDatasets","n8n-nodes-base.dateTime","n8n-nodes-base.crypto","n8n-nodes-base.html","n8n-nodes-base.htmlExtract","n8n-nodes-base.xml","@n8n/n8n-nodes-langchain.agent","@n8n/n8n-nodes-langchain.agentTool","@n8n/n8n-nodes-langchain.chatTrigger","@n8n/n8n-nodes-langchain.manualChatTrigger","@n8n/n8n-nodes-langchain.lmChatOpenAi","@n8n/n8n-nodes-langchain.lmChatAnthropic","@n8n/n8n-nodes-langchain.lmChatGoogleGemini","@n8n/n8n-nodes-langchain.lmChatOllama","@n8n/n8n-nodes-langchain.memoryBufferWindow","@n8n/n8n-nodes-langchain.memoryPostgresChat","@n8n/n8n-nodes-langchain.toolHttpRequest","@n8n/n8n-nodes-langchain.toolCode","@n8n/n8n-nodes-langchain.toolWorkflow","@n8n/n8n-nodes-langchain.toolCalculator","@n8n/n8n-nodes-langchain.toolThink"]
